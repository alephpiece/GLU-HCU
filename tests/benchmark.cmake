cmake_minimum_required(VERSION 3.19)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(WRITE "${TEST_DIRECTORY}/a.mtx" "2 2 4\n1 1 3\n2 1 -1\n1 2 -1\n2 2 3\n")
file(WRITE "${TEST_DIRECTORY}/b.mtx" "3 3 3\n1 1 2\n2 2 3\n3 3 4\n")
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx"
    --tasks 7 --warmup 2 --loops 3 --tmp-slots 1 --output "${TEST_DIRECTORY}/mixed.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "mixed benchmark failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/mixed.json" result)
foreach(field tasks streams checked_tasks)
    string(JSON value GET "${result}" ${field})
    if(NOT value EQUAL 7)
        message(FATAL_ERROR "wrong ${field}: ${value}")
    endif()
endforeach()
string(JSON count LENGTH "${result}" loop_ms)
string(JSON first GET "${result}" templates 0 tasks)
string(JSON second GET "${result}" templates 1 tasks)
if(NOT count EQUAL 3 OR NOT first EQUAL 4 OR NOT second EQUAL 3)
    message(FATAL_ERROR "incorrect loops or task assignment")
endif()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx"
    --tasks 7 --warmup 1 --loops 2 --check basic --diagnostics --output "${TEST_DIRECTORY}/basic.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "basic diagnostic run failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/basic.json" basic)
string(JSON mode GET "${basic}" check_mode)
string(JSON residual_type TYPE "${basic}" max_factor_residual)
string(JSON submit_count LENGTH "${basic}" submit_ms)
string(JSON drain_count LENGTH "${basic}" drain_ms)
string(JSON launches GET "${basic}" launches_per_loop)
string(JSON tolerance_type TYPE "${basic}" factor_residual_tolerance)
string(JSON checked GET "${basic}" checked_tasks)
# Dense 2x2: two factor/clear pairs + one update; diagonal 3x3: three pairs.
if(NOT mode STREQUAL "basic" OR NOT residual_type STREQUAL "NULL" OR
   NOT tolerance_type STREQUAL "NULL" OR NOT checked EQUAL 7 OR
   NOT submit_count EQUAL 2 OR NOT drain_count EQUAL 2 OR NOT launches EQUAL 38)
    message(FATAL_ERROR "incorrect basic validation or launch accounting")
endif()
foreach(field submit_thread_cpu_ms drain_thread_cpu_ms)
    string(JSON cpu_count LENGTH "${basic}" ${field})
    if(NOT cpu_count EQUAL 2)
        message(FATAL_ERROR "incorrect thread CPU sample count: ${field}")
    endif()
    foreach(index RANGE 0 1)
        string(JSON value GET "${basic}" ${field} ${index})
        if(value LESS 0)
            message(FATAL_ERROR "negative thread CPU time: ${field}")
        endif()
    endforeach()
endforeach()
# Logical counts 4+3 with batches of three produce two full batches and one tail.
foreach(execution direct graph)
    set(graph_option)
    if(execution STREQUAL "graph")
        set(graph_option --graph)
    endif()
    execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx"
        --tasks 7 --batch-size 3 --warmup 1 --loops 2 --diagnostics ${graph_option}
        --output "${TEST_DIRECTORY}/batch-${execution}.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "batch ${execution} failed: ${output}${error}")
    endif()
    file(READ "${TEST_DIRECTORY}/batch-${execution}.json" batch)
    string(JSON checked GET "${batch}" checked_tasks)
    string(JSON streams GET "${batch}" streams)
    string(JSON launches GET "${batch}" launches_per_loop)
    if(NOT checked EQUAL 7 OR NOT streams EQUAL 3 OR NOT launches EQUAL 16)
        message(FATAL_ERROR "incorrect tail-batch task/stream/launch accounting")
    endif()
endforeach()
# Mapped updates and parallel host submission preserve all tasks and tail batches.
foreach(execution direct graph)
    set(graph_option)
    if(execution STREQUAL "graph")
        set(graph_option --graph)
    endif()
    execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx"
        --tasks 7 --batch-size 3 --updates mapped --submit-threads 4
        --warmup 1 --loops 2 --diagnostics ${graph_option}
        --output "${TEST_DIRECTORY}/mapped-parallel-${execution}.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "mapped parallel ${execution} failed: ${output}${error}")
    endif()
    file(READ "${TEST_DIRECTORY}/mapped-parallel-${execution}.json" mapped)
    string(JSON checked GET "${mapped}" checked_tasks)
    string(JSON launches GET "${mapped}" launches_per_loop)
    string(JSON threads GET "${mapped}" actual_submit_threads)
    string(JSON bytes GET "${mapped}" update_map_bytes)
    string(JSON shared GET "${mapped}" shared_device_bytes)
    string(JSON ordering GET "${mapped}" ordering)
    string(JSON backend GET "${mapped}" backend)
    string(JSON bits GET "${mapped}" real_bits)
    set(expected_launches 9)
    if(backend STREQUAL "CUDA" AND bits EQUAL 64)
        set(expected_launches 10)
    endif()
    if(NOT checked EQUAL 7 OR NOT launches EQUAL expected_launches OR NOT threads EQUAL 3 OR
       NOT bytes GREATER 0 OR shared LESS bytes OR NOT ordering STREQUAL "parallel-batches")
        message(FATAL_ERROR "mapped parallel accounting incorrect")
    endif()
    foreach(field submit_workers_cpu_ms submit_worker_max_wall_ms)
        string(JSON count LENGTH "${mapped}" ${field})
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "wrong parallel diagnostic count: ${field}")
        endif()
        foreach(i RANGE 0 1)
            string(JSON value GET "${mapped}" ${field} ${i})
            if(value LESS 0)
                message(FATAL_ERROR "negative worker diagnostic: ${field}")
            endif()
        endforeach()
    endforeach()
endforeach()
foreach(option --updates --submit-threads)
    if(option STREQUAL "--updates")
        set(invalid unknown)
    else()
        set(invalid 0)
    endif()
    execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" ${option} ${invalid}
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "accepted invalid ${option}")
    endif()
endforeach()
# A wide diagonal level needs five batches at eight slots, with no one-column kernels.
file(WRITE "${TEST_DIRECTORY}/wide.mtx" "33 33 33\n")
foreach(i RANGE 1 33)
    file(APPEND "${TEST_DIRECTORY}/wide.mtx" "${i} ${i} 2\n")
endforeach()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/wide.mtx"
    --tmp-slots 8 --warmup 0 --loops 1 --output "${TEST_DIRECTORY}/wide.json" --diagnostics
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "wide diagnostic run failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/wide.json" wide)
string(JSON mode GET "${wide}" check_mode)
string(JSON residual_type TYPE "${wide}" max_factor_residual)
string(JSON launches GET "${wide}" launches_per_loop)
string(JSON bits GET "${wide}" real_bits)
string(JSON h2d GET "${wide}" h2d_bytes_per_loop)
string(JSON d2h GET "${wide}" d2h_bytes_per_loop)
math(EXPR bytes "33 * ${bits} / 8")
if(NOT mode STREQUAL "full" OR NOT residual_type STREQUAL "NUMBER" OR
   NOT launches EQUAL 5 OR NOT h2d EQUAL bytes OR NOT d2h EQUAL bytes)
    message(FATAL_ERROR "incorrect full validation, wide launch count or transfer bytes")
endif()
# Mapped uses one whole-level launch and no scratch, regardless of the slot cap.
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/wide.mtx"
    --updates mapped --tmp-slots 8 --warmup 0 --loops 1 --diagnostics
    --output "${TEST_DIRECTORY}/wide-mapped.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "wide mapped diagnostic failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/wide-mapped.json" mapped_wide)
string(JSON launches GET "${mapped_wide}" launches_per_loop)
string(JSON slots GET "${mapped_wide}" templates 0 effective_tmp_slots)
string(JSON residual GET "${mapped_wide}" max_factor_residual)
if(NOT launches EQUAL 1 OR NOT slots EQUAL 0 OR NOT residual EQUAL 0)
    message(FATAL_ERROR "incorrect mapped wide-level launch/scratch accounting")
endif()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" --check none
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "accepted an invalid check mode")
endif()
foreach(bad -1 0 1x 18446744073709551615 184467440737095516160)
    execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" --tasks "${bad}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "accepted invalid task count ${bad}")
    endif()
endforeach()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx" --tasks 1
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "silently dropped an input template")
endif()
# Exercise output failure after a valid run, and absence of a GPU.
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" --loops 1 --warmup 0 --output /dev/full
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "failed output was accepted")
endif()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" --loops 1 --warmup 0
    RESULT_VARIABLE status OUTPUT_FILE /dev/full ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "failed to write standard output")
    message(FATAL_ERROR "failed standard output was not reported: ${status}: ${error}")
endif()
# Explicit workload: uneven counts, non-cyclic order and a relative path with spaces.
file(COPY_FILE "${TEST_DIRECTORY}/a.mtx" "${TEST_DIRECTORY}/matrix a.mtx")
file(WRITE "${TEST_DIRECTORY}/weighted.workload"
    "# independent tasks\nglu-workload 1\nmatrix a \"matrix a.mtx\"\nmatrix b b.mtx\ntask b\ntask a\ntask a\ntask a\n")
execute_process(COMMAND "${GLU_BENCH}" --workload "${TEST_DIRECTORY}/weighted.workload"
    --warmup 1 --loops 2 --diagnostics --output "${TEST_DIRECTORY}/weighted.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "explicit workload failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/weighted.json" weighted)
string(JSON first GET "${weighted}" task_templates 0)
string(JSON last GET "${weighted}" task_templates 3)
string(JSON count LENGTH "${weighted}" task_templates)
string(JSON acount GET "${weighted}" templates 0 tasks)
string(JSON bcount GET "${weighted}" templates 1 tasks)
string(JSON checked GET "${weighted}" checked_tasks)
string(JSON launches GET "${weighted}" launches_per_loop)
string(JSON bits GET "${weighted}" real_bits)
string(JSON h2d GET "${weighted}" h2d_bytes_per_loop)
string(JSON d2h GET "${weighted}" d2h_bytes_per_loop)
math(EXPR expected_bytes "(3 * 4 + 3) * ${bits} / 8")
if(NOT first EQUAL 1 OR NOT last EQUAL 0 OR NOT count EQUAL 4 OR
   NOT acount EQUAL 3 OR NOT bcount EQUAL 1 OR NOT checked EQUAL 4 OR
   NOT launches EQUAL 21 OR NOT h2d EQUAL expected_bytes OR NOT d2h EQUAL expected_bytes)
    message(FATAL_ERROR "workload mapping or weighted accounting incorrect")
endif()
# Workload integration: preserve logical order, regroup nonuniform counts and tails.
string(JSON actual_order GET "${weighted}" batch_templates)
string(JSON logical_order GET "${weighted}" task_templates)
if(NOT actual_order STREQUAL logical_order)
    message(FATAL_ERROR "batch1 changed explicit task order")
endif()
foreach(execution direct graph)
    set(graph_option)
    if(execution STREQUAL "graph")
        set(graph_option --graph)
    endif()
    execute_process(COMMAND "${GLU_BENCH}" --workload "${TEST_DIRECTORY}/weighted.workload"
        --batch-size 2 ${graph_option} --warmup 1 --loops 2 --diagnostics
        --output "${TEST_DIRECTORY}/weighted-${execution}.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "weighted batch ${execution} failed: ${output}${error}")
    endif()
    file(READ "${TEST_DIRECTORY}/weighted-${execution}.json" result)
    string(JSON streams GET "${result}" streams)
    string(JSON checked GET "${result}" checked_tasks)
    string(JSON launches GET "${result}" launches_per_loop)
    string(JSON order GET "${result}" task_templates)
    if(NOT streams EQUAL 3 OR NOT checked EQUAL 4 OR NOT launches EQUAL 16 OR
       NOT order STREQUAL logical_order)
        message(FATAL_ERROR "weighted batch counts or logical identity changed")
    endif()
    foreach(field task_device_bytes pinned_bytes h2d_bytes_per_loop d2h_bytes_per_loop)
        string(JSON before GET "${weighted}" ${field})
        string(JSON after GET "${result}" ${field})
        if(NOT before EQUAL after)
            message(FATAL_ERROR "weighted batch changed ${field}")
        endif()
    endforeach()
    foreach(i RANGE 0 2)
        string(JSON templ GET "${result}" batch_templates ${i})
        string(JSON size GET "${result}" batch_sizes ${i})
        if(i EQUAL 0)
            if(NOT templ EQUAL 0 OR NOT size EQUAL 2)
                message(FATAL_ERROR "wrong first weighted batch")
            endif()
        elseif(i EQUAL 1)
            if(NOT templ EQUAL 1 OR NOT size EQUAL 1)
                message(FATAL_ERROR "wrong second weighted batch")
            endif()
        elseif(NOT templ EQUAL 0 OR NOT size EQUAL 1)
            message(FATAL_ERROR "wrong weighted tail batch")
        endif()
    endforeach()
endforeach()
foreach(invalid
    "glu-workload 2\n"
    "glu-workload 1\nmatrix a a.mtx\ntask missing\n"
    "glu-workload 1\nmatrix a a.mtx\nmatrix a b.mtx\ntask a\n"
    "glu-workload 1\nmatrix a a.mtx\nmatrix b b.mtx\ntask a\n"
    "glu-workload 1\nmatrix a a.mtx\ntask a extra\n"
    "glu-workload 1\nmatrix a a.mtx\ntask a\nmatrix b b.mtx\n")
    file(WRITE "${TEST_DIRECTORY}/invalid.workload" "${invalid}")
    execute_process(COMMAND "${GLU_BENCH}" --workload "${TEST_DIRECTORY}/invalid.workload"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 10)
    if(NOT status EQUAL 1 OR NOT error MATCHES "Benchmark failed:")
        message(FATAL_ERROR "invalid workload not rejected: ${status}: ${error}")
    endif()
endforeach()
foreach(extra -i --tasks)
    execute_process(COMMAND "${GLU_BENCH}" --workload "${TEST_DIRECTORY}/weighted.workload" "${extra}" 1
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 10)
    if(NOT status EQUAL 1 OR NOT error MATCHES "cannot be combined")
        message(FATAL_ERROR "conflicting workload arguments accepted")
    endif()
endforeach()

# Repeated mixed batches retain per-copy upload and complete output payloads.
foreach(graph "" "--graph")
    execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" -i "${TEST_DIRECTORY}/b.mtx"
        --tasks 7 --batch-size 3 --updates mapped --submit-threads 4
        --warmup 1 --loops 3 --diagnostics ${graph} --output "${TEST_DIRECTORY}/payload${graph}.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "mixed payload run failed: ${output}${error}")
    endif()
    file(READ "${TEST_DIRECTORY}/payload${graph}.json" result)
    string(JSON input_order GET "${result}" input_submission)
    string(JSON uploads GET "${result}" h2d_copy_ops_per_loop)
    string(JSON downloads GET "${result}" d2h_copy_ops_per_loop)
    string(JSON bytes GET "${result}" h2d_bytes_per_loop)
    string(JSON bits GET "${result}" real_bits)
    string(JSON pinned GET "${result}" pinned_bytes)
    string(JSON checked GET "${result}" checked_tasks)
    math(EXPR expected_bytes "25*${bits}/8")
    math(EXPR expected_pinned "32*${bits}/8")
    set(expected_downloads 7)
    if(graph)
        set(expected_downloads 3)
    endif()
    if(NOT input_order STREQUAL "per-batch-chain" OR NOT uploads EQUAL 7 OR NOT downloads EQUAL expected_downloads OR NOT bytes EQUAL expected_bytes OR
       NOT pinned EQUAL expected_pinned OR NOT checked EQUAL 7)
        message(FATAL_ERROR "mixed input/output payload accounting failed")
    endif()
endforeach()
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/wide.mtx" --tasks 35 --batch-size 33
    --updates mapped --graph --warmup 1 --loops 2 --diagnostics --output "${TEST_DIRECTORY}/padding.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "padding/tail failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/padding.json" result)
string(JSON bytes GET "${result}" task_device_bytes)
string(JSON bits GET "${result}" real_bits)
string(JSON first GET "${result}" soa_value_strides 0)
string(JSON tail GET "${result}" soa_value_strides 1)
math(EXPR expected "33*(35+64+2)*${bits}/8")
if(NOT bytes EQUAL expected OR NOT first EQUAL 64 OR NOT tail EQUAL 2)
    message(FATAL_ERROR "incorrect natural padding or exact tail bytes")
endif()

set(ENV{CUDA_VISIBLE_DEVICES} "-1")
set(ENV{HIP_VISIBLE_DEVICES} "-1")
execute_process(COMMAND "${GLU_BENCH}" -i "${TEST_DIRECTORY}/a.mtx" --loops 1 --warmup 0
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "missing GPU was accepted")
endif()
